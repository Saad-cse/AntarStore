# Copy this file to .env (or otherwise set these as real environment variables
# in your shell / IDE run configuration) before running AntarStore locally.
# NEVER commit an actual .env file with real values to source control.

# MySQL
 DB_USERNAME=root
 DB_PASSWORD=changeme

# Gmail (or other SMTP) used to send OTP verification emails.
# For Gmail, this must be a 16-character "App Password", not your normal
# account password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Razorpay - use TEST mode keys (rzp_test_...) while developing.
# Get them from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
